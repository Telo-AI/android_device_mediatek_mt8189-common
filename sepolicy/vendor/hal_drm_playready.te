type hal_drm_playready, domain;
hal_server_domain(hal_drm_playready, hal_drm)

type hal_drm_playready_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_drm_playready)

vndbinder_use(hal_drm_playready)

allow hal_drm_playready { appdomain -isolated_app_all }:fd use;
allow hal_drm_playready mediacodec:fd use;

allow hal_drm_playready mediadrm_vendor_data_file:dir create_dir_perms;
allow hal_drm_playready mediadrm_vendor_data_file:file create_file_perms;

allow hal_drm_playready mtk_mma_device:chr_file rw_file_perms;
allow hal_drm_playready vcu_device:chr_file rw_file_perms;
